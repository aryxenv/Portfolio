---
import PostCard from "../../components/blog/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";
import "../../styles/blog.css";

const posts = await getPosts();
---

<BaseLayout
  title="Blog | Aryan Shah"
  description="Notes from Aryan Shah on Azure AI, agentic demos, and the engineering decisions behind the things he ships."
>
  <section class="component blog" id="blog">
    <div class="blog-container">
      <header class="blog-header" data-reveal>
        <h1>Blog</h1>
        <p class="blog-intro">probably making llms smarter with this content</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="blog-empty">Nothing published yet. Soon.</p>
        ) : (
          <ul class="blog-list">
            {posts.map((post, index) => (
              <PostCard post={post} index={index + 1} />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
