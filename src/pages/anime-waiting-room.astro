---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/ui/Reveal.astro";
---

<BaseLayout
  title="Anime Waiting Room | Aryan Shah"
  description="Track countdowns for your favorite airing anime. Snappy, lightweight, and responsive."
>
  <section class="anime-waiting-room" id="anime-waiting-room">
    <!-- Pre-paint check for empty state to prevent FOUC / layout shifts -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("selectedAnimes");
          var parsed = saved ? JSON.parse(saved) : [];
          if (!parsed || !Array.isArray(parsed) || parsed.length === 0) {
            document.documentElement.classList.add("anime-empty-preset");
          } else {
            document.documentElement.classList.remove("anime-empty-preset");
          }
        } catch (e) {
          document.documentElement.classList.add("anime-empty-preset");
        }
      })();
    </script>

    <div class="anime-container">
      <Reveal class="anime-header">
        <h1>Anime Waiting Room</h1>
        <p class="subtitle">Track countdowns for your favorite airing anime.</p>
      </Reveal>

      <Reveal class="anime-search-wrapper" index={1}>
        <div class="search-box-wrapper">
          <form id="anime-form" class="glow-card">
            <input type="text" id="anime-search" placeholder="Search anime to add..." required autocomplete="off" />
            <button type="submit" id="add-anime-btn" aria-label="Add Anime">
              <i class="bx bx-plus"></i>
            </button>
          </form>
          <div id="search-feedback" class="search-feedback" aria-live="polite"></div>
        </div>
      </Reveal>

      <Reveal class="anime-list-wrapper" index={2} data-lenis-prevent="true">
        <div id="anime-list" class="anime-list" aria-busy="true" aria-live="polite">
          <span class="visually-hidden">Loading anime countdowns...</span>
          <div class="anime-item glow-card skeleton-card" style="--card-index: 0;" aria-hidden="true">
            <div class="main-info">
              <div class="skeleton-line skeleton-title" style="width: 58%;"></div>
              <div class="status-row">
                <div class="skeleton-line skeleton-status"></div>
                <div class="skeleton-line skeleton-link"></div>
              </div>
            </div>
            <div class="skeleton-line skeleton-timer"></div>
            <div class="skeleton-line skeleton-btn"></div>
          </div>
          <div class="anime-item glow-card skeleton-card" style="--card-index: 1;" aria-hidden="true">
            <div class="main-info">
              <div class="skeleton-line skeleton-title" style="width: 72%;"></div>
              <div class="status-row">
                <div class="skeleton-line skeleton-status"></div>
                <div class="skeleton-line skeleton-link"></div>
              </div>
            </div>
            <div class="skeleton-line skeleton-timer"></div>
            <div class="skeleton-line skeleton-btn"></div>
          </div>
          <div class="anime-item glow-card skeleton-card" style="--card-index: 2;" aria-hidden="true">
            <div class="main-info">
              <div class="skeleton-line skeleton-title" style="width: 46%;"></div>
              <div class="status-row">
                <div class="skeleton-line skeleton-status"></div>
                <div class="skeleton-line skeleton-link"></div>
              </div>
            </div>
            <div class="skeleton-line skeleton-timer"></div>
            <div class="skeleton-line skeleton-btn"></div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* Override the default layout margins to perfectly fit the screen */
  :global(.page) {
    margin-top: calc(var(--navbar-height) + 1.5rem) !important;
    margin-bottom: 0 !important;
  }

  .anime-container {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0 auto;
    text-align: left;
    height: calc(100dvh - var(--navbar-height) - 3rem);
    transition: justify-content 0.3s var(--ease);
  }

  .anime-container.empty-state {
    justify-content: center;
  }

  .anime-container.empty-state .anime-list-wrapper {
    display: none;
  }

  :global(html.anime-empty-preset) .anime-container {
    justify-content: center !important;
  }

  :global(html.anime-empty-preset) .anime-list-wrapper {
    display: none !important;
  }

  :global(html.anime-empty-preset) .search-box-wrapper,
  :global(html.anime-empty-preset) #anime-form {
    max-width: 720px !important;
  }

  .anime-header {
    text-align: center;
    flex-shrink: 0;
  }

  .anime-header h1 {
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--primary-color);
  }

  .subtitle {
    color: var(--primary-color);
    font-size: clamp(0.95rem, 4vw, 1.1rem);
    opacity: 0.9;
  }

  .anime-search-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    flex-shrink: 0;
  }

  .search-box-wrapper {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: max-width 0.5s var(--ease);
  }

  :global(.search-box-wrapper.expanded) {
    max-width: 720px !important;
  }

  .search-feedback {
    font-size: 0.875rem;
    color: var(--accent-red);
    text-align: center;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.25s var(--ease), opacity 0.25s var(--ease), margin-top 0.25s var(--ease);
  }

  .search-feedback.visible {
    max-height: 2.5rem;
    margin-top: 0.5rem;
    opacity: 1;
  }

  .anime-waiting-room {
    width: 100%;
  }

  #anime-form {
    display: flex;
    width: 100%;
    background: transparent;
    border: var(--border-px) solid var(--border-color);
    border-radius: 5px;
    position: relative;
    /* transition is handled by glow-card hover effect */
  }

  #anime-form input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 1.2rem 1.5rem;
    color: var(--primary-color);
    font-family: var(--font-family);
    font-size: 1rem;
    outline: none;
  }
  
  #anime-form input::placeholder {
    color: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.5);
  }

  #anime-form button {
    background: transparent;
    border: none;
    border-left: var(--border-px) solid var(--border-color);
    color: var(--primary-color);
    padding: 0 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: background-color var(--state-duration) var(--ease), color var(--state-duration) var(--ease);
  }

  #anime-form button:hover {
    background: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.1);
  }

  .anime-list-wrapper {
    width: 100%;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* Hide scrollbar */
    scrollbar-width: none; /* Firefox */
    position: relative;
    z-index: 10;
  }

  .anime-list-wrapper::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }

  .anime-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Skeleton Loading Styles */
  :global(.skeleton-card) {
    pointer-events: none;
    user-select: none;
    border-color: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.2);
  }
  
  :global(.skeleton-line) {
    position: relative;
    overflow: hidden;
    background: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.07);
    border-radius: 5px;
  }
  
  :global(.skeleton-line::after) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transform: translateX(-100%);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.12) 50%,
      transparent 100%
    );
    animation: skeleton-sweep 1.8s ease-in-out infinite;
    animation-delay: calc(var(--card-index, 0) * 0.16s);
  }

  @keyframes skeleton-sweep {
    100% {
      transform: translateX(100%);
    }
  }

  :global(.skeleton-title) {
    height: 1.15rem;
    margin-bottom: 0.5rem;
  }

  :global(.skeleton-status) {
    height: 0.855rem;
    width: 130px;
  }

  :global(.skeleton-link) {
    height: 0.855rem;
    width: 90px;
    opacity: 0.6;
  }

  :global(.skeleton-timer) {
    height: 42px;
    width: 160px;
    min-width: 160px;
    border-radius: 5px;
    border: var(--border-px) solid rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.1);
    flex-shrink: 0;
  }

  :global(.skeleton-btn) {
    height: 40px;
    width: 40px;
    border-radius: 5px;
    border: var(--border-px) solid rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.1);
    flex-shrink: 0;
  }

  :global(html[data-perf="low"]) :global(.skeleton-line::after),
  @media (prefers-reduced-motion: reduce) {
    :global(.skeleton-line::after) {
      animation: none !important;
      display: none !important;
    }
  }

  /* Global styles for dynamic items */
  :global(.anime-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: var(--border-px) solid var(--border-color);
    border-radius: 5px;
    padding: 1.25rem;
    gap: 1rem;
    position: relative;
    transition: border-color var(--state-duration) var(--ease);
  }

  :global(.anime-item.glow-card:not(.skeleton-card):hover) {
    border-color: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.8);
  }

  :global(.anime-item .main-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.anime-item .name) {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary-color);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.anime-item .status-row) {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  :global(.anime-item .status) {
    color: var(--primary-color);
    opacity: 0.85;
  }

  :global(.anime-item .mal-link) {
    color: var(--primary-color);
    opacity: 0.5;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--state-duration) var(--ease);
    font-size: 0.85rem;
  }

  :global(.anime-item .mal-link:hover) {
    opacity: 1;
  }

  :global(.anime-item .timer) {
    font-family: monospace;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--primary-color);
    background: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.05);
    padding: 0.5rem 1rem;
    border-radius: 5px;
    min-width: 160px;
    text-align: center;
    border: var(--border-px) solid rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.1);
  }

  :global(.anime-item .remove-btn),
  :global(.anime-item .retry-btn) {
    background: transparent;
    border: var(--border-px) solid rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.3);
    color: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.8);
    width: 40px;
    height: 40px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--state-duration) var(--ease);
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  :global(.anime-item .remove-btn:hover) {
    border-color: var(--accent-red);
    color: var(--accent-red);
    background: rgba(255, 123, 114, 0.1);
  }

  :global(.anime-item .retry-btn:hover) {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.1);
  }
  
  :global(.anime-item.fade-out) {
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  :global(.anime-item.anime-error-item) {
    border-color: rgba(255, 123, 114, 0.35);
    background: rgba(255, 123, 114, 0.03);
  }

  :global(.anime-error-item .error-msg) {
    color: var(--accent-red) !important;
    opacity: 0.9;
  }

  :global(.error-actions) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-shrink: 0;
  }

  :global(.anime-item.highlight-pulse) {
    animation: highlight-pulse-anim 1.2s var(--ease);
  }

  @keyframes highlight-pulse-anim {
    0% {
      border-color: var(--primary-color);
      box-shadow: 0 0 15px rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.4);
    }
    50% {
      border-color: var(--primary-color);
      box-shadow: 0 0 25px rgba(var(--primary-r), var(--primary-g), var(--primary-b), 0.6);
    }
    100% {
      border-color: var(--border-color);
      box-shadow: none;
    }
  }

  @media (max-width: 650px) {
    :global(.anime-item) {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    
    :global(.anime-item .timer) {
      width: 100%;
    }

    :global(.anime-item .remove-btn),
    :global(.anime-item .retry-btn) {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      border: none;
      background: transparent;
    }

    :global(.error-actions) {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
    }

    :global(.error-actions .remove-btn),
    :global(.error-actions .retry-btn) {
      position: static;
    }

    :global(.skeleton-card .skeleton-title) {
      margin-left: auto;
      margin-right: auto;
    }

    :global(.skeleton-card .status-row) {
      justify-content: center;
    }

    :global(.skeleton-card .skeleton-timer) {
      width: 100%;
    }

    :global(.skeleton-card .skeleton-btn) {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      border: none;
    }
  }
</style>

<script>
  interface AnimeData {
    mal_id: number;
    title_english?: string;
    title?: string;
    status?: string;
    broadcast?: { day?: string; time?: string };
    images?: {
      jpg?: { image_url?: string };
      webp?: { image_url?: string };
    };
  }

  interface SavedAnime {
    input: string;
    title: string | null;
    cachedData?: AnimeData | null;
    cachedAt?: number;
  }

  const STORAGE_KEY = "selectedAnimes";
  const CACHE_TTL_MS = 12 * 60 * 60 * 1000; // 12 hours cache TTL
  const activeTimers = new Map<string, { nextBroadcastDay: Date; element: HTMLElement }>();
  const renderedMalIds = new Set<number>();
  let intervalId: ReturnType<typeof setInterval> | null = null;
  let animeList: SavedAnime[] = [];

  class AnimeRequestQueue {
    private delayMs: number;
    private queue: Array<{
      id: string;
      taskFactory: (signal: AbortSignal) => Promise<Response>;
      priority: boolean;
      resolve: (data: any) => void;
      reject: (err: any) => void;
    }> = [];
    private isProcessing = false;
    private lastRequestTime = 0;
    private isAborted = false;
    private currentAbortController: AbortController | null = null;

    constructor(delayMs = 350) {
      this.delayMs = delayMs;
    }

    enqueue<T>(
      id: string,
      taskFactory: (signal: AbortSignal) => Promise<Response>,
      priority = false
    ): Promise<T> {
      if (this.isAborted) return Promise.reject(new Error("Queue aborted"));
      return new Promise<T>((resolve, reject) => {
        // Deduplicate in queue: replace existing pending task with same id
        this.queue = this.queue.filter((item) => item.id !== id);
        const item = { id, taskFactory, priority, resolve, reject };
        if (priority) {
          this.queue.unshift(item);
        } else {
          this.queue.push(item);
        }
        this.processNext();
      });
    }

    cancel(id: string) {
      this.queue = this.queue.filter((item) => item.id !== id);
    }

    abort() {
      this.isAborted = true;
      if (this.currentAbortController) {
        this.currentAbortController.abort();
        this.currentAbortController = null;
      }
      this.queue.forEach((item) => item.reject(new Error("Queue aborted")));
      this.queue = [];
      this.isProcessing = false;
    }

    private async processNext() {
      if (this.isProcessing || this.isAborted || this.queue.length === 0) return;
      this.isProcessing = true;

      while (this.queue.length > 0 && !this.isAborted) {
        const now = Date.now();
        const elapsed = now - this.lastRequestTime;
        if (elapsed < this.delayMs) {
          await new Promise((r) => setTimeout(r, this.delayMs - elapsed));
        }
        if (this.isAborted) break;

        const item = this.queue.shift();
        if (!item) break;

        try {
          const result = await this.executeWithRetry(item.taskFactory);
          this.lastRequestTime = Date.now();
          item.resolve(result);
        } catch (err) {
          this.lastRequestTime = Date.now();
          item.reject(err);
        }
      }

      this.isProcessing = false;
    }

    private async executeWithRetry(
      taskFactory: (signal: AbortSignal) => Promise<Response>,
      maxRetries = 3
    ): Promise<any> {
      let attempt = 0;
      while (!this.isAborted) {
        attempt++;
        this.currentAbortController = new AbortController();
        const signal = this.currentAbortController.signal;

        try {
          const response = await taskFactory(signal);
          this.currentAbortController = null;

          // Empirical rate limit handling (HTTP 429)
          if (response.status === 429) {
            if (attempt > maxRetries) {
              throw new Error(`Rate limit exceeded after ${maxRetries} retries`);
            }
            const retryHeader = response.headers.get("retry-after");
            const retrySec = retryHeader ? Math.max(parseFloat(retryHeader), 1) : 1;
            const waitTime = Math.round(retrySec * 1000 + 250 + attempt * 200);
            console.warn(
              `[Tenrai API] Rate limited (429). Pausing queue for ${waitTime}ms (Attempt ${attempt}/${maxRetries})...`
            );
            await new Promise((r) => setTimeout(r, waitTime));
            continue;
          }

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          const data = await response.json();
          return data;
        } catch (err: any) {
          this.currentAbortController = null;
          if (this.isAborted || err.name === "AbortError") throw err;
          if (attempt >= maxRetries) throw err;
          const waitTime = Math.min(1000 * Math.pow(2, attempt - 1), 5000);
          console.warn(`[Tenrai API] Fetch error: ${err.message}. Retrying in ${waitTime}ms...`);
          await new Promise((r) => setTimeout(r, waitTime));
        }
      }
      throw new Error("Aborted");
    }
  }

  let requestQueue: AnimeRequestQueue | null = null;

  function getNextDayOfWeek(date: Date, dayOfWeek: number) {
    const nextDay = new Date(date);
    nextDay.setDate(date.getDate() + ((dayOfWeek + 7 - date.getDay()) % 7));
    return nextDay;
  }

  function parseBroadcast(broadcast: { day?: string; time?: string } | null | undefined) {
    if (!broadcast || !broadcast.day || !broadcast.time) return null;
    const daysMap: Record<string, number> = {
      sunday: 0,
      sundays: 0,
      monday: 1,
      mondays: 1,
      tuesday: 2,
      tuesdays: 2,
      wednesday: 3,
      wednesdays: 3,
      thursday: 4,
      thursdays: 4,
      friday: 5,
      fridays: 5,
      saturday: 6,
      saturdays: 6,
    };
    const dayOfWeek = daysMap[broadcast.day.toLowerCase().trim()];
    if (dayOfWeek === undefined) return null;

    const nowDate = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Tokyo" }));
    const nextBroadcastDay = getNextDayOfWeek(nowDate, dayOfWeek);

    const [broadcastHour, broadcastMinute] = broadcast.time.split(":");
    nextBroadcastDay.setHours(parseInt(broadcastHour, 10), parseInt(broadcastMinute, 10), 0, 0);

    // If scheduled broadcast has already passed earlier today in Tokyo, advance to next week
    if (nextBroadcastDay.getTime() <= nowDate.getTime()) {
      nextBroadcastDay.setDate(nextBroadcastDay.getDate() + 7);
    }

    const [thours, tminutes] = broadcast.time.split(":").map(Number);
    const date = new Date();
    date.setUTCHours(thours - 9, tminutes, 0, 0);

    const localTime = new Intl.DateTimeFormat("en-US", {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZoneName: "short",
    }).format(date);

    return {
      nextBroadcastDay,
      formattedDate: `${(nextBroadcastDay.getMonth() + 1).toString().padStart(2, "0")}/${nextBroadcastDay.getDate().toString().padStart(2, "0")}/${nextBroadcastDay.getFullYear()} - ${localTime}`,
    };
  }

  function updateTimers() {
    const nowDate = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Tokyo" }));

    activeTimers.forEach((timerInfo) => {
      const { nextBroadcastDay, element } = timerInfo;
      const differenceMs = nextBroadcastDay.getTime() - nowDate.getTime();

      if (differenceMs > 0) {
        const differenceSeconds = Math.floor(differenceMs / 1000);
        const days = Math.floor(differenceSeconds / (60 * 60 * 24));
        const hours = Math.floor((differenceSeconds % (60 * 60 * 24)) / (60 * 60));
        const minutes = Math.floor((differenceSeconds % (60 * 60)) / 60);
        const seconds = differenceSeconds % 60;
        element.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s`;
      } else {
        element.textContent = "0d 0h 0m 0s";
      }
    });
  }

  async function fetchAnimeInfo(animeName: string, priority = false): Promise<AnimeData | null> {
    if (!requestQueue) return null;
    const url = `https://api.tenrai.org/v1/anime?q=${encodeURIComponent(animeName)}&limit=1&order_by=end_date&sort=desc&type=tv`;
    const data = await requestQueue.enqueue<any>(
      animeName.toLowerCase(),
      (signal) => fetch(url, { signal }),
      priority
    );
    if (data && Array.isArray(data.data) && data.data.length > 0) {
      return data.data[0] as AnimeData;
    }
    return null;
  }

  function escapeHTML(str: string): string {
    return str.replace(/[&<>'"]/g, (tag) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#39;",
      '"': "&quot;",
    }[tag] || tag));
  }

  function getSavedAnimes(): SavedAnime[] {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return [];
      const parsed = JSON.parse(saved);
      if (!Array.isArray(parsed)) return [];
      return parsed
        .map((item: any): SavedAnime | null => {
          if (typeof item === "string") {
            const trimmed = item.trim();
            return trimmed ? { input: trimmed, title: trimmed, cachedData: null, cachedAt: 0 } : null;
          }
          if (item && typeof item === "object") {
            const input = typeof item.input === "string" ? item.input.trim() : (typeof item.title === "string" ? item.title.trim() : "");
            if (!input) return null;
            return {
              input,
              title: typeof item.title === "string" ? item.title : null,
              cachedData: item.cachedData || null,
              cachedAt: typeof item.cachedAt === "number" ? item.cachedAt : 0,
            };
          }
          return null;
        })
        .filter((item): item is SavedAnime => item !== null);
    } catch {
      return [];
    }
  }

  function persistAnimeList() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(animeList));
  }

  function showSearchFeedback(msg: string) {
    const feedback = document.getElementById("search-feedback");
    if (!feedback) return;
    feedback.textContent = msg;
    feedback.classList.add("visible");
    setTimeout(() => {
      feedback.classList.remove("visible");
    }, 3500);
  }

  function getSkeletonInnerCardHTML(index: number = 0) {
    const titleWidths = ["58%", "72%", "46%", "64%"];
    const width = titleWidths[index % titleWidths.length];
    return `
      <div class="main-info">
        <div class="skeleton-line skeleton-title" style="width: ${width};"></div>
        <div class="status-row">
          <div class="skeleton-line skeleton-status"></div>
          <div class="skeleton-line skeleton-link"></div>
        </div>
      </div>
      <div class="skeleton-line skeleton-timer"></div>
      <div class="skeleton-line skeleton-btn"></div>
    `;
  }

  function renderAnimeCard(card: HTMLElement, animeData: AnimeData, inputName: string) {
    const { mal_id, title_english, title, status, broadcast } = animeData;
    const displayTitle = title_english || title || inputName;

    card.className = "anime-item glow-card";
    card.removeAttribute("aria-hidden");
    card.id = `anime-card-${mal_id}`;
    card.dataset.input = inputName;
    card.dataset.malId = mal_id.toString();

    let statusText = status || "Unknown";
    let bCastInfo = null;

    if (status === "Currently Airing") {
      bCastInfo = parseBroadcast(broadcast);
      if (bCastInfo) {
        statusText = bCastInfo.formattedDate;
      }
    } else if (status === "Not yet aired") {
      statusText = "To be announced";
    }

    card.innerHTML = `
      <div class="main-info">
        <div class="name">${escapeHTML(displayTitle)}</div>
        <div class="status-row">
          <span class="status">${escapeHTML(statusText)}</span>
          <a href="https://myanimelist.net/anime/${mal_id}" target="_blank" rel="noopener noreferrer" class="mal-link">See Details (MAL)</a>
        </div>
      </div>
      <div class="timer" id="timer-${mal_id}">0d 0h 0m 0s</div>
      <button class="remove-btn" aria-label="Remove ${escapeHTML(displayTitle)}" data-input="${escapeHTML(inputName)}">
        <i class="bx bx-x"></i>
      </button>
    `;

    if (status === "Currently Airing" && bCastInfo) {
      activeTimers.set(mal_id.toString(), {
        nextBroadcastDay: bCastInfo.nextBroadcastDay,
        element: card.querySelector(`#timer-${mal_id}`) as HTMLElement,
      });
      updateTimers();
    } else {
      activeTimers.delete(mal_id.toString());
    }

    const removeBtn = card.querySelector(".remove-btn");
    removeBtn?.addEventListener("click", () => handleRemove(inputName, mal_id.toString(), card));
  }

  function renderErrorCard(card: HTMLElement, inputName: string, errorType: "not_found" | "network_error") {
    card.className = "anime-item anime-error-item glow-card";
    card.removeAttribute("aria-hidden");
    card.dataset.input = inputName;

    const isNotFound = errorType === "not_found";
    const message = isNotFound
      ? "Anime not found on MyAnimeList."
      : "Unable to load schedule (network / rate limit).";

    card.innerHTML = `
      <div class="main-info">
        <div class="name">${escapeHTML(inputName)}</div>
        <div class="status-row">
          <span class="status error-msg">${escapeHTML(message)}</span>
        </div>
      </div>
      <div class="error-actions">
        ${
          !isNotFound
            ? `<button class="retry-btn" aria-label="Retry loading ${escapeHTML(inputName)}" data-input="${escapeHTML(inputName)}">
                <i class="bx bx-refresh"></i>
              </button>`
            : ""
        }
        <button class="remove-btn" aria-label="Remove ${escapeHTML(inputName)}" data-input="${escapeHTML(inputName)}">
          <i class="bx bx-x"></i>
        </button>
      </div>
    `;

    const retryBtn = card.querySelector(".retry-btn");
    retryBtn?.addEventListener("click", () => {
      card.className = "anime-item glow-card skeleton-card";
      card.setAttribute("aria-hidden", "true");
      card.innerHTML = getSkeletonInnerCardHTML(0);
      fetchAndBindCard(card, inputName, true);
    });

    const removeBtn = card.querySelector(".remove-btn");
    removeBtn?.addEventListener("click", () => handleRemove(inputName, null, card));
  }

  function handleRemove(inputName: string, malIdStr: string | null, card: HTMLElement) {
    card.classList.add("fade-out");
    setTimeout(() => {
      card.remove();
    }, 300);

    if (malIdStr) {
      activeTimers.delete(malIdStr);
      renderedMalIds.delete(parseInt(malIdStr, 10));
    }
    if (requestQueue) {
      requestQueue.cancel(inputName.toLowerCase());
    }

    animeList = animeList.filter((a) => a.input.toLowerCase() !== inputName.toLowerCase());
    persistAnimeList();

    if (animeList.length === 0) {
      const container = document.querySelector(".anime-container");
      const form = document.getElementById("anime-form");
      const searchBoxWrapper = document.querySelector(".search-box-wrapper");
      container?.classList.add("empty-state");
      form?.classList.add("expanded");
      searchBoxWrapper?.classList.add("expanded");
    }
  }

  async function fetchAndBindCard(card: HTMLElement, inputName: string, priority = false) {
    try {
      const data = await fetchAnimeInfo(inputName, priority);
      if (!data) {
        renderErrorCard(card, inputName, "not_found");
        return;
      }

      // Check if duplicate
      if (renderedMalIds.has(data.mal_id)) {
        card.remove();
        animeList = animeList.filter((a) => a.input.toLowerCase() !== inputName.toLowerCase());
        persistAnimeList();
        return;
      }

      renderedMalIds.add(data.mal_id);
      renderAnimeCard(card, data, inputName);

      // Cache the result
      const found = animeList.find((a) => a.input.toLowerCase() === inputName.toLowerCase());
      if (found) {
        found.cachedData = data;
        found.cachedAt = Date.now();
        found.title = data.title_english || data.title || found.title;
        persistAnimeList();
      }
    } catch (err: any) {
      if (err.message === "Queue aborted" || err.name === "AbortError") return;
      renderErrorCard(card, inputName, "network_error");
    }
  }

  async function initAnimeRoom() {
    document.documentElement.classList.remove("anime-empty-preset");
    const listContainer = document.getElementById("anime-list");
    const form = document.getElementById("anime-form");
    const searchBoxWrapper = document.querySelector(".search-box-wrapper");
    const input = document.getElementById("anime-search") as HTMLInputElement;
    const container = document.querySelector(".anime-container");

    if (!listContainer || !form || !input || !container) return;

    // Reset runtime state
    activeTimers.clear();
    renderedMalIds.clear();
    if (intervalId) clearInterval(intervalId);
    if (requestQueue) requestQueue.abort();
    requestQueue = new AnimeRequestQueue(350);

    animeList = getSavedAnimes();

    if (animeList.length === 0) {
      listContainer.innerHTML = "";
      listContainer.removeAttribute("aria-busy");
      container.classList.add("empty-state");
      form.classList.add("expanded");
      searchBoxWrapper?.classList.add("expanded");
    } else {
      container.classList.remove("empty-state");
      form.classList.remove("expanded");
      searchBoxWrapper?.classList.remove("expanded");
      listContainer.innerHTML = "";
      listContainer.setAttribute("aria-busy", "true");

      const now = Date.now();

      animeList.forEach((item, index) => {
        const card = document.createElement("div");

        // If cached and valid data exists, render immediately in 0ms!
        if (item.cachedData) {
          renderedMalIds.add(item.cachedData.mal_id);
          renderAnimeCard(card, item.cachedData, item.input);
          listContainer.appendChild(card);

          // Stale-While-Revalidate if cache is older than 12 hours
          if (now - (item.cachedAt || 0) > CACHE_TTL_MS) {
            fetchAnimeInfo(item.input, false)
              .then((freshData) => {
                if (
                  freshData &&
                  (!item.cachedData ||
                    freshData.status !== item.cachedData.status ||
                    freshData.broadcast?.time !== item.cachedData.broadcast?.time)
                ) {
                  item.cachedData = freshData;
                  item.cachedAt = Date.now();
                  persistAnimeList();
                  renderAnimeCard(card, freshData, item.input);
                }
              })
              .catch(() => {
                // Stale cache remains in place on error
              });
          }
        } else {
          // Uncached item: render progressive skeleton card in slot
          card.className = "anime-item glow-card skeleton-card";
          card.setAttribute("aria-hidden", "true");
          card.style.setProperty("--card-index", index.toString());
          card.innerHTML = getSkeletonInnerCardHTML(index);
          listContainer.appendChild(card);

          fetchAndBindCard(card, item.input, false);
        }
      });

      listContainer.removeAttribute("aria-busy");
    }

    intervalId = setInterval(updateTimers, 1000);

    // Form Submission
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) return;

      const existing = animeList.find((a) => a.input.toLowerCase() === query.toLowerCase());
      if (existing) {
        showSearchFeedback(`"${query}" is already in your waiting room!`);
        input.value = "";
        // Highlight existing card
        const existingCard = listContainer.querySelector(`[data-input="${CSS.escape(existing.input)}"]`);
        if (existingCard) {
          existingCard.classList.remove("highlight-pulse");
          void (existingCard as HTMLElement).offsetWidth;
          existingCard.classList.add("highlight-pulse");
          existingCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
        return;
      }

      container.classList.remove("empty-state");
      form.classList.remove("expanded");
      searchBoxWrapper?.classList.remove("expanded");

      // Insert progressive loading skeleton card at top
      const tempCard = document.createElement("div");
      tempCard.className = "anime-item glow-card skeleton-card";
      tempCard.setAttribute("aria-hidden", "true");
      tempCard.innerHTML = getSkeletonInnerCardHTML(0);
      listContainer.insertBefore(tempCard, listContainer.firstChild);

      // Register temporary entry in animeList
      animeList.unshift({
        input: query,
        title: query,
        cachedData: null,
        cachedAt: 0,
      });
      persistAnimeList();
      input.value = "";

      // Fetch with priority!
      try {
        const data = await fetchAnimeInfo(query, true);
        if (!data) {
          tempCard.remove();
          animeList = animeList.filter((a) => a.input.toLowerCase() !== query.toLowerCase());
          persistAnimeList();
          showSearchFeedback(`No anime found matching "${query}". Check title spelling.`);
          if (animeList.length === 0) {
            container.classList.add("empty-state");
            form.classList.add("expanded");
            searchBoxWrapper?.classList.add("expanded");
          }
          return;
        }

        // Check if duplicate mal_id
        if (renderedMalIds.has(data.mal_id)) {
          tempCard.remove();
          animeList = animeList.filter((a) => a.input.toLowerCase() !== query.toLowerCase());
          persistAnimeList();
          showSearchFeedback(`This anime is already in your waiting room!`);
          return;
        }

        renderedMalIds.add(data.mal_id);
        renderAnimeCard(tempCard, data, query);

        const found = animeList.find((a) => a.input.toLowerCase() === query.toLowerCase());
        if (found) {
          found.cachedData = data;
          found.cachedAt = Date.now();
          found.title = data.title_english || data.title || found.title;
          persistAnimeList();
        }
      } catch (err: any) {
        if (err.message === "Queue aborted" || err.name === "AbortError") return;
        renderErrorCard(tempCard, query, "network_error");
      }
    });
  }

  // Handle Astro's view transitions correctly
  document.addEventListener("astro:page-load", initAnimeRoom);
  document.addEventListener("astro:before-swap", () => {
    if (intervalId) clearInterval(intervalId);
    intervalId = null;
    activeTimers.clear();
    renderedMalIds.clear();
    if (requestQueue) {
      requestQueue.abort();
      requestQueue = null;
    }
  });
</script>
