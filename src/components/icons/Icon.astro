---
import { ICON_PATHS, type IconName } from "./paths";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d={ICON_PATHS[name]}></path>
</svg>
