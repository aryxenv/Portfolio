---
/**
 * The vertical "keep going" rail: a rotated label and a chevron inside an
 * outlined column. Three of these were inline markup in two sections.
 *
 * Variants exist because the original class families differ in real ways
 * (padding, arrow size, layout), not just in name.
 */
interface Props {
  href: string;
  label: string;
  variant?: "default" | "smaller" | "contact-me";
}

const { href, label, variant = "default" } = Astro.props;

const isContactMe = variant === "contact-me";
const isSmaller = variant === "smaller";
---

<a
  href={href}
  class:list={[
    "glow-card",
    isContactMe ? "contact-me-container-vertical" : "viewMoreVertical",
    isSmaller && "viewMoreVertical-smaller",
  ]}
>
  <div
    class:list={[
      isContactMe ? "contact-me-opacityLayer" : "opacityLayer",
      isSmaller && "opacityLayer-smaller",
    ]}
  >
    <div class={isContactMe ? "contact-me-title" : "viewMore-title"}>
      <span class:list={["rotate90deg", isSmaller && "rotate90deg-smaller"]}>
        {label}
      </span>
    </div>

    <div
      class={isContactMe
        ? "contact-me-arrow"
        : isSmaller
          ? "viewMore-arrow-smaller"
          : "viewMore-arrow"}
    >
      <i class="bx bx-chevron-down"></i>
    </div>
  </div>
</a>
